# ---- Python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- machine-specific settings written by the GUI ----
# These hold local paths (Fiji folder, data folders) and change on every run.
# An example lives in config/gui_config.example.json instead.
_gui_config.json
_gui_labels.txt
cargo_gui_settings.json

# ---- microscopy data and results: NEVER commit these ----
# Raw images are hundreds of MB each; GitHub rejects files over 100 MB and the
# repository would become unusable. Data belongs on the lab drive, not in git.
*.tif
*.tiff
*.png
*.jpg
*.jpeg
*_results.csv
*_summary.csv
*_batch_summary.csv
*_curated.csv
*_bbox.csv
*_log.txt
*_cnn.csv
run_manifest_*.json
run_manifest_*.txt
edited_results/

# ---- trained CNN models ----
# Weights are binary and change with every training run; the reports contain
# per-cell data. The whole models/ folder stays local. Attach the model used
# for a thesis figure to a GitHub Release instead.

# allow images that document the code itself
!docs/**/*.png

# trained CNN models: weights, reports and per-cell predictions stay local
models/

# the launcher remembers the environment it chose (machine-specific)
launcher_environment.txt

# a Python environment made by "Setup on this PC.bat" (machine-specific)
.venv/
# conda folder for unusual install places (machine-specific)
conda_path.txt
